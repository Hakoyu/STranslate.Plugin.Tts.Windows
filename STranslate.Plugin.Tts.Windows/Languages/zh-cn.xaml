<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Engine">语音引擎</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Engine_Description">选择 Windows 语音引擎。插件不会自动回退。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Engine_WindowsMedia">Windows Media（OneCore）</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Engine_SystemSpeech">System.Speech（SAPI）</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Voice">音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Voice_Description">当前引擎已安装的音色。Windows Media 与 System.Speech 使用不同的音色列表。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_RefreshVoices">刷新音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Speed">语速</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Speed_Description">朗读速度范围为 0.50× 至 2.00×。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Volume">音量</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Volume_Description">音量范围为 0 至 100%。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_Test">测试朗读</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_TestButton">播放测试</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_TestText">这是一段 Windows 本地文字转语音测试。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_TestSuccess">测试朗读成功</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_TestFailure">测试朗读失败</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_VoicesLoaded">已加载 {0} 个音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_VoicesLoadFailure">无法加载已安装音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_NoVoices">所选引擎没有已安装的音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_VoiceRequired">请选择音色</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_VoiceUnavailable">所选音色不可用：{0}</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Windows_EmptyAudio">语音引擎未返回音频数据</sys:String>
</ResourceDictionary>
